---
import Layout from "../layouts/Layout.astro";
import CalendarSlide from "../components/CalendarSlide.astro";
import NewsSlide from "../components/NewsSlide.astro";
import DrinksSlide from "../components/DrinksSlide.astro";
import config from "../data/tv-config.json";
---

<Layout>
  <!-- ===== Top Bar with logo, name, clock ===== -->
  <header class="top-bar">
    <div class="brand">
      <img
        src="/maakleerplek-logo.png"
        alt="Maakleerplek-HTL"
        class="brand-logo animated-logo"
      />
      <div class="brand-text">
        <span class="brand-name">{config.branding.organizationName}</span>
        <span class="brand-tagline">{config.branding.tagline}</span>
      </div>
    </div>
    <div class="header-right">
      <div class="live-clock" id="live-clock"></div>
    </div>
  </header>

  <!-- ===== Swiper Slideshow ===== -->
  <div class="swiper tv-swiper" id="tv-swiper">
    <div class="swiper-wrapper">
      <!-- Slide 1: Calendar (skeleton, populated by JS) -->
      <div class="swiper-slide">
        <CalendarSlide
          events={[]}
          title={config.calendar.title}
          maxEvents={config.calendar.maxEventsToShow}
        />
      </div>

      <!-- Slide 2: News (skeleton, populated by JS) -->
      <div class="swiper-slide">
        <NewsSlide
          newsItems={[]}
          title={config.news.title}
          maxItems={config.news.maxItems}
        />
      </div>

      <!-- Slide 3: Drinks & QR -->
      <div class="swiper-slide">
        <DrinksSlide title={config.drinks.title} />
      </div>
    </div>

    <!-- Pagination dots -->
    <div class="swiper-pagination"></div>

    <!-- Slide progress bar -->
    <div class="slide-progress">
      <div class="slide-progress-bar" id="slide-progress-bar"></div>
    </div>
  </div>
</Layout>

<script
  define:vars={{
    intervalSeconds: config.slideshow.intervalSeconds,
    transitionEffect: config.slideshow.transitionEffect,
    autoRefreshMinutes: config.slideshow.autoRefreshMinutes,
    apiBase: config.dataFetcher.browserBaseUrl,
    calendarEndpoint: config.dataFetcher.calendarEndpoint,
    newsEndpoint: config.dataFetcher.newsEndpoint,
    maxEvents: config.calendar.maxEventsToShow,
    maxNews: config.news.maxItems,
  }}
>
  document.addEventListener("DOMContentLoaded", () => {
    // ── Live Clock ──────────────────────────────────────────
    const clockEl = document.getElementById("live-clock");
    function updateClock() {
      if (!clockEl) return;
      const now = new Date();
      const opts = {
        weekday: "long",
        day: "numeric",
        month: "long",
        hour: "2-digit",
        minute: "2-digit",
      };
      clockEl.textContent = now.toLocaleDateString("nl-BE", opts);
    }
    updateClock();
    setInterval(updateClock, 1000);

    // ── Swiper Init ─────────────────────────────────────────
    const swiperEl = document.getElementById("tv-swiper");
    if (swiperEl && typeof Swiper !== "undefined") {
      const swiper = new Swiper("#tv-swiper", {
        effect: transitionEffect,
        fadeEffect: { crossFade: true },
        loop: true,
        speed: 800,
        autoplay: {
          delay: intervalSeconds * 1000,
          disableOnInteraction: false,
        },
        pagination: {
          el: ".swiper-pagination",
          clickable: true,
        },
      });

      // Progress bar animation
      const progressBar = document.getElementById("slide-progress-bar");
      if (progressBar) {
        function resetProgress() {
          progressBar.style.transition = "none";
          progressBar.style.width = "0%";
          void progressBar.offsetWidth;
          progressBar.style.transition = `width ${intervalSeconds}s linear`;
          progressBar.style.width = "100%";
        }
        resetProgress();
        swiper.on("slideChange", resetProgress);
      }
    }

    // ── Auto Refresh ────────────────────────────────────────
    if (autoRefreshMinutes > 0) {
      setInterval(
        () => {
          window.location.reload();
        },
        autoRefreshMinutes * 60 * 1000,
      );
    }

    // ═══════════════════════════════════════════════════════
    //  Client-Side Data Fetching & Rendering
    // ═══════════════════════════════════════════════════════

    const LOCATION_COLORS = {
      "high tech lab": "#0077B6",
      textiellab: "#E76F51",
      "grafisch lab": "#9B5DE5",
      gereedschappenbib: "#F4A261",
      "elektro herstel hub": "#2A9D8F",
      kantine: "#E63946",
      "cowork plek": "#457B9D",
      "deelplek ateliers": "#6D6875",
      "textiel herstel hub": "#E5989B",
    };

    function getLocationColor(location) {
      if (!location) return "var(--primary)";
      const lower = location.toLowerCase();
      for (const [key, color] of Object.entries(LOCATION_COLORS)) {
        if (lower.includes(key)) return color;
      }
      return "var(--primary)";
    }

    function formatDateHeader(dateText) {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);
      const cleaned = dateText.trim().toLowerCase();
      const dayMatch = cleaned.match(/\w+\s+(\d+)\s+(\w+)/);
      if (dayMatch) {
        const day = parseInt(dayMatch[1], 10);
        if (day === today.getDate()) return "Vandaag";
        if (day === tomorrow.getDate()) return "Morgen";
      }
      return dateText.charAt(0).toUpperCase() + dateText.slice(1);
    }

    function truncate(text, max) {
      if (!text) return "";
      return text.length > max ? text.substring(0, max) + "\u2026" : text;
    }

    function esc(text) {
      if (!text) return "";
      const el = document.createElement("span");
      el.textContent = text;
      return el.innerHTML;
    }

    // ── Render Calendar ─────────────────────────────────────
    function renderCalendar(events) {
      const slide = document.querySelector(".calendar-slide");
      if (!slide) return;

      // Remove existing dynamic content
      const old = slide.querySelector(".timeline");
      const empty = slide.querySelector(".empty-state");
      if (old) old.remove();
      if (empty) empty.remove();

      if (!events || events.length === 0) {
        slide.insertAdjacentHTML(
          "beforeend",
          '<div class="empty-state"><span class="material-symbols-outlined empty-icon">event_busy</span><p>Geen komende evenementen gevonden</p></div>',
        );
        return;
      }

      // Group by date
      const grouped = {};
      for (const ev of events.slice(0, maxEvents)) {
        const key = ev.date || "Onbekend";
        if (!grouped[key]) grouped[key] = [];
        grouped[key].push(ev);
      }

      let html = '<div class="timeline">';
      for (const [date, dayEvents] of Object.entries(grouped)) {
        html +=
          '<div class="day-group"><div class="day-header"><div class="day-dot"></div><h3>' +
          esc(formatDateHeader(date)) +
          '</h3></div><div class="day-events">';
        for (const ev of dayEvents) {
          const color = getLocationColor(ev.location);
          html += '<div class="event-card elevation-1">';
          if (ev.imageUrl) {
            html +=
              '<div class="event-image-wrap"><img src="' +
              esc(ev.imageUrl) +
              '" alt="' +
              esc(ev.title) +
              '" class="event-image" loading="lazy" /></div>';
          }
          html += '<div class="event-content"><div class="event-top-row">';
          if (ev.location) {
            html +=
              '<span class="location-badge" style="background:' +
              color +
              "15;color:" +
              color +
              ';"><span class="material-symbols-outlined badge-icon">location_on</span>' +
              esc(ev.location) +
              "</span>";
          }
          if (ev.time) {
            html +=
              '<span class="event-time"><span class="material-symbols-outlined badge-icon">schedule</span>' +
              esc(ev.time) +
              "</span>";
          }
          html += '</div><h4 class="event-title">' + esc(ev.title) + "</h4>";
          if (ev.description) {
            html +=
              '<p class="event-description">' +
              esc(truncate(ev.description, 120)) +
              "</p>";
          }
          html += "</div></div>";
        }
        html += "</div></div>";
      }
      html += "</div>";
      slide.insertAdjacentHTML("beforeend", html);
    }

    // ── Render News ─────────────────────────────────────────
    function renderNews(items) {
      const slide = document.querySelector(".news-slide");
      if (!slide) return;

      const grid = slide.querySelector(".news-grid");
      const empty = slide.querySelector(".empty-state");
      if (grid) grid.remove();
      if (empty) empty.remove();

      const display = (items || []).slice(0, maxNews);

      if (display.length === 0) {
        slide.insertAdjacentHTML(
          "beforeend",
          '<div class="empty-state"><span class="material-symbols-outlined empty-icon">article</span><p>Geen recent nieuws gevonden</p></div>',
        );
        return;
      }

      let html = '<div class="news-grid">';
      display.forEach((item, i) => {
        const feat = i === 0 ? " featured" : "";
        html += '<article class="news-card elevation-2' + feat + '">';
        if (item.imageUrl) {
          html +=
            '<div class="news-image-wrap"><img src="' +
            esc(item.imageUrl) +
            '" alt="' +
            esc(item.title) +
            '" class="news-image" loading="lazy" /><div class="image-gradient"></div></div>';
        }
        html += '<div class="news-content">';
        if (item.date) {
          html +=
            '<span class="news-date"><span class="material-symbols-outlined date-icon">calendar_today</span>' +
            esc(item.date) +
            "</span>";
        }
        html += '<h3 class="news-title">' + esc(item.title) + "</h3>";
        if (item.description) {
          html +=
            '<p class="news-description">' +
            esc(truncate(item.description, 150)) +
            "</p>";
        }
        html += "</div></article>";
      });
      html += "</div>";
      slide.insertAdjacentHTML("beforeend", html);
    }

    // ── Fetch Data from API ─────────────────────────────────
    async function fetchData() {
      try {
        const calRes = await fetch(apiBase + calendarEndpoint);
        if (calRes.ok) renderCalendar(await calRes.json());
      } catch (e) {
        console.warn("[TV] Calendar fetch failed:", e.message);
      }

      try {
        const newsRes = await fetch(apiBase + newsEndpoint);
        if (newsRes.ok) renderNews(await newsRes.json());
      } catch (e) {
        console.warn("[TV] News fetch failed:", e.message);
      }
    }

    fetchData();
  });
</script>

<style>
  /* ===== Top Bar ===== */
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 48px;
    background: var(--surface);
    border-bottom: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    position: relative;
    z-index: 10;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-logo {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--primary);
    letter-spacing: -0.02em;
  }

  .brand-tagline {
    font-size: 0.8rem;
    color: var(--text-tertiary);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .live-clock {
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--text-secondary);
    text-transform: capitalize;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .htl-logo {
    height: 36px;
    width: auto;
    filter: brightness(0) saturate(100%) invert(36%) sepia(99%) saturate(500%)
      hue-rotate(154deg);
    opacity: 0.7;
  }

  /* Subtle pulse animation on the maakleerplek cube logo */
  .animated-logo {
    animation: gentle-pulse 4s ease-in-out infinite;
  }

  @keyframes gentle-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  /* ===== Swiper Overrides ===== */
  .tv-swiper {
    height: calc(100vh - 78px);
  }

  .tv-swiper .swiper-slide {
    padding-top: 28px;
  }

  /* ===== Slide Progress Bar ===== */
  .slide-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(0, 0, 0, 0.05);
    z-index: 20;
  }

  .slide-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--primary), var(--primary-light));
    border-radius: 0 2px 2px 0;
  }

  /* Bottom padding for pagination */
  .tv-swiper .swiper-pagination {
    bottom: 12px !important;
  }
</style>
