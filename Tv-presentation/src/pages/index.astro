---
import Layout from "../layouts/Layout.astro";
import CalendarPanel from "../components/CalendarPanel.astro";
import NewsCarousel from "../components/NewsCarousel.astro";
import DrinksPanel from "../components/DrinksPanel.astro";
import TipsBox from "../components/TipsBox.astro";
import config from "../data/tv-config.json";
---

<Layout>
  <!-- ===== Top Bar ===== -->
  <header
    class="flex items-center justify-between px-8 py-3 bg-surface border-b border-border shadow-card relative z-10"
  >
    <div class="flex items-center gap-3">
      <img
        src="/maakleerplek-logo.png"
        alt="Maakleerplek"
        class="w-10 h-10 rounded-lg object-contain animate-pulse-gentle"
      />
      <div class="flex flex-col">
        <span class="text-xl font-semibold text-primary tracking-tight"
          >{config.branding.organizationName}</span
        >
        <span
          class="text-[0.65rem] text-text-tertiary font-light uppercase tracking-widest"
          >{config.branding.tagline}</span
        >
      </div>
    </div>
    <div class="flex items-center gap-6">
      <div
        class="text-sm font-normal text-text-secondary capitalize"
        id="live-clock"
      >
      </div>
    </div>
  </header>

  <!-- ===== Main Three-Panel Layout ===== -->
  <main class="flex h-[calc(100vh-64px)] overflow-hidden">
    <!-- Left Sidebar: Calendar -->
    <aside
      class="w-[18%] min-w-[220px] border-r border-border bg-surface p-4 overflow-hidden flex flex-col"
    >
      <CalendarPanel />
    </aside>

    <!-- Center: News Carousel -->
    <section class="flex-1 bg-background p-4 overflow-hidden flex flex-col">
      <NewsCarousel />
    </section>

    <!-- Right Sidebar: Drinks + Tips -->
    <aside
      class="w-[26%] min-w-[280px] border-l border-border bg-surface p-4 overflow-hidden flex flex-col"
    >
      <div class="flex-1 overflow-hidden">
        <DrinksPanel />
      </div>
      <div class="mt-3">
        <TipsBox />
      </div>
    </aside>
  </main>
</Layout>

<style>
  @keyframes pulse-gentle {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.04);
    }
  }
  .animate-pulse-gentle {
    animation: pulse-gentle 4s ease-in-out infinite;
  }
</style>

<script
  define:vars={{
    intervalSeconds: config.carousel.intervalSeconds,
    transitionSpeedMs: config.carousel.transitionSpeedMs,
    autoRefreshMinutes: config.carousel.autoRefreshMinutes,
    apiBase: config.dataFetcher.browserBaseUrl,
    calendarEndpoint: config.dataFetcher.calendarEndpoint,
    newsEndpoint: config.dataFetcher.newsEndpoint,
    maxEvents: config.calendar.maxEventsToShow,
    maxNews: config.news.maxItems,
  }}
>
  document.addEventListener("DOMContentLoaded", () => {
    // ── Live Clock ──────────────────────────────────────────
    const clockEl = document.getElementById("live-clock");
    function updateClock() {
      if (!clockEl) return;
      const now = new Date();
      const opts = {
        weekday: "long",
        day: "numeric",
        month: "long",
        hour: "2-digit",
        minute: "2-digit",
      };
      clockEl.textContent = now.toLocaleDateString("nl-BE", opts);
    }
    updateClock();
    setInterval(updateClock, 1000);

    // ── Auto Refresh ────────────────────────────────────────
    if (autoRefreshMinutes > 0) {
      setInterval(
        () => {
          window.location.reload();
        },
        autoRefreshMinutes * 60 * 1000,
      );
    }

    // ── Utility functions ───────────────────────────────────
    const LOCATION_COLORS = {
      "high tech lab": "#0077B6",
      textiellab: "#E76F51",
      "grafisch lab": "#9B5DE5",
      gereedschappenbib: "#F4A261",
      "elektro herstel hub": "#2A9D8F",
      kantine: "#E63946",
      "cowork plek": "#457B9D",
      "deelplek ateliers": "#6D6875",
      "textiel herstel hub": "#E5989B",
    };

    function getLocationColor(location) {
      if (!location) return "#008080";
      const lower = location.toLowerCase();
      for (const [key, color] of Object.entries(LOCATION_COLORS)) {
        if (lower.includes(key)) return color;
      }
      return "#008080";
    }

    function formatDateHeader(dateText) {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);
      const cleaned = dateText.trim().toLowerCase();
      const dayMatch = cleaned.match(/\w+\s+(\d+)\s+(\w+)/);
      if (dayMatch) {
        const day = parseInt(dayMatch[1], 10);
        if (day === today.getDate()) return "Today";
        if (day === tomorrow.getDate()) return "Tomorrow";
      }
      return dateText.charAt(0).toUpperCase() + dateText.slice(1);
    }

    function truncate(text, max) {
      if (!text) return "";
      return text.length > max ? text.substring(0, max) + "\u2026" : text;
    }

    function esc(text) {
      if (!text) return "";
      const el = document.createElement("span");
      el.textContent = text;
      return el.innerHTML;
    }

    // ══════════════════════════════════════════════════════════
    //  Render Calendar Panel
    // ══════════════════════════════════════════════════════════
    function renderCalendar(events) {
      const container = document.getElementById("calendar-events");
      if (!container) return;
      container.innerHTML = "";

      if (!events || events.length === 0) {
        container.innerHTML =
          '<div class="flex flex-col items-center justify-center h-full text-text-tertiary gap-2">' +
          '<span class="material-symbols-outlined text-4xl">event_busy</span>' +
          '<p class="text-sm">No upcoming events</p>' +
          "</div>";
        return;
      }

      const display = events.slice(0, maxEvents);
      let html = "";

      for (const ev of display) {
        const color = getLocationColor(ev.location);
        const dateLabel = ev.date ? formatDateHeader(ev.date) : "";

        html +=
          '<div class="bg-surface rounded-xl p-3 border border-border shadow-card hover:shadow-card-md transition-shadow">' +
          '<div class="flex items-center gap-2 mb-1.5 flex-wrap">';

        if (dateLabel) {
          html +=
            '<span class="text-[0.65rem] font-semibold text-primary uppercase tracking-wider">' +
            esc(dateLabel) +
            "</span>";
        }
        if (ev.time) {
          html +=
            '<span class="text-[0.65rem] text-text-tertiary flex items-center gap-0.5">' +
            '<span class="material-symbols-outlined text-xs">schedule</span>' +
            esc(ev.time) +
            "</span>";
        }

        html +=
          "</div>" +
          '<h4 class="text-sm font-medium text-text-primary leading-snug mb-1">' +
          esc(truncate(ev.title, 60)) +
          "</h4>";

        if (ev.location) {
          html +=
            '<span class="inline-flex items-center gap-0.5 text-[0.6rem] font-medium px-1.5 py-0.5 rounded-full" style="background:' +
            color +
            "12;color:" +
            color +
            ';">' +
            '<span class="material-symbols-outlined text-xs">location_on</span>' +
            esc(ev.location) +
            "</span>";
        }

        html += "</div>";
      }

      container.innerHTML = html;
    }

    // ══════════════════════════════════════════════════════════
    //  Render News Carousel
    // ══════════════════════════════════════════════════════════
    let currentSlide = 0;
    let newsItems = [];
    let carouselInterval = null;

    function createSlideHtml(item) {
      const imageHtml = item.imageUrl
        ? '<img src="' +
          esc(item.imageUrl) +
          '" alt="' +
          esc(item.title) +
          '" class="w-full h-full object-cover" loading="lazy" />'
        : '<div class="w-full h-full flex items-center justify-center bg-surface-variant">' +
          '<img src="/htl-logo.svg" alt="HTL Logo" class="w-24 h-24 opacity-30" />' +
          "</div>";

      return (
        '<div class="bg-surface rounded-2xl shadow-card-md border border-border w-full max-w-2xl h-[80%] flex overflow-hidden">' +
        '<div class="w-2/5 flex-shrink-0 overflow-hidden bg-surface-variant">' +
        imageHtml +
        "</div>" +
        '<div class="flex-1 p-6 flex flex-col justify-center">' +
        (item.date
          ? '<span class="text-xs text-text-tertiary uppercase tracking-wider flex items-center gap-1 mb-2">' +
            '<span class="material-symbols-outlined text-sm">calendar_today</span>' +
            esc(item.date) +
            "</span>"
          : "") +
        '<h3 class="text-lg font-semibold text-text-primary leading-snug mb-3">' +
        esc(item.title) +
        "</h3>" +
        (item.description
          ? '<p class="text-sm text-text-secondary leading-relaxed">' +
            esc(truncate(item.description, 200)) +
            "</p>"
          : "") +
        "</div>" +
        "</div>"
      );
    }

    function renderNewsCarousel(items) {
      const viewport = document.getElementById("carousel-viewport");
      const dotsContainer = document.getElementById("carousel-dots");
      if (!viewport || !dotsContainer) return;

      newsItems = (items || []).slice(0, maxNews);

      if (newsItems.length === 0) {
        viewport.innerHTML =
          '<div class="flex flex-col items-center justify-center h-full text-text-tertiary gap-2">' +
          '<span class="material-symbols-outlined text-5xl">article</span>' +
          '<p class="text-base">No recent news found</p>' +
          "</div>";
        dotsContainer.innerHTML = "";
        return;
      }

      // Create slides
      let slidesHtml = "";
      for (let i = 0; i < newsItems.length; i++) {
        const state =
          i === 0
            ? "active"
            : i === newsItems.length - 1
              ? "prev"
              : i === 1
                ? "next"
                : "hidden";
        slidesHtml +=
          '<div class="carousel-slide" data-state="' +
          state +
          '" data-index="' +
          i +
          '">' +
          createSlideHtml(newsItems[i]) +
          "</div>";
      }
      viewport.innerHTML = slidesHtml;

      // Create dots
      let dotsHtml = "";
      for (let i = 0; i < newsItems.length; i++) {
        const activeClass = i === 0 ? "w-6 bg-primary" : "w-2 bg-primary/30";
        dotsHtml +=
          '<button class="h-2 rounded-full transition-all duration-500 ' +
          activeClass +
          '" data-dot="' +
          i +
          '"></button>';
      }
      dotsContainer.innerHTML = dotsHtml;

      // Start auto-advance
      currentSlide = 0;
      startCarousel();
    }

    function updateSlideStates() {
      const slides = document.querySelectorAll(".carousel-slide");
      const dots = document.querySelectorAll("[data-dot]");

      slides.forEach((slide) => {
        const idx = parseInt(slide.getAttribute("data-index"));
        const total = newsItems.length;

        const prevIdx = (currentSlide - 1 + total) % total;
        const nextIdx = (currentSlide + 1) % total;

        if (idx === currentSlide) {
          slide.setAttribute("data-state", "active");
        } else if (idx === prevIdx) {
          slide.setAttribute("data-state", "prev");
        } else if (idx === nextIdx) {
          slide.setAttribute("data-state", "next");
        } else {
          slide.setAttribute("data-state", "hidden");
        }
      });

      dots.forEach((dot) => {
        const idx = parseInt(dot.getAttribute("data-dot"));
        if (idx === currentSlide) {
          dot.className =
            "h-2 rounded-full transition-all duration-500 w-6 bg-primary";
        } else {
          dot.className =
            "h-2 rounded-full transition-all duration-500 w-2 bg-primary/30";
        }
      });
    }

    function advanceSlide() {
      currentSlide = (currentSlide + 1) % newsItems.length;
      updateSlideStates();
    }

    function startCarousel() {
      if (carouselInterval) clearInterval(carouselInterval);
      if (newsItems.length > 1) {
        carouselInterval = setInterval(advanceSlide, intervalSeconds * 1000);
      }
    }

    // ══════════════════════════════════════════════════════════
    //  Fetch Data
    // ══════════════════════════════════════════════════════════
    async function fetchData() {
      try {
        const calRes = await fetch(apiBase + calendarEndpoint);
        if (calRes.ok) renderCalendar(await calRes.json());
      } catch (e) {
        console.warn("[TV] Calendar fetch failed:", e.message);
      }

      try {
        const newsRes = await fetch(apiBase + newsEndpoint);
        if (newsRes.ok) renderNewsCarousel(await newsRes.json());
      } catch (e) {
        console.warn("[TV] News fetch failed:", e.message);
      }
    }

    fetchData();
  });
</script>
