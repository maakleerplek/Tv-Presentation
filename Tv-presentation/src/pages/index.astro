---
import Layout from "../layouts/Layout.astro";
import CalendarPanel from "../components/CalendarPanel.astro";
import NewsCarousel from "../components/NewsCarousel.astro";
import DrinksPanel from "../components/DrinksPanel.astro";
import TipsBox from "../components/TipsBox.astro";
import config from "../data/tv-config.json";

const apiIp = import.meta.env.API_IP || "";
const browserBaseUrl = "/api";
---

<Layout>
  <!-- ===== Top Bar ===== -->
  <header
    class="flex items-center justify-between px-8 py-3 bg-surface border-b border-border shadow-card relative z-10"
  >
    <div class="flex items-center gap-3">
      <img
        src="/maakleerplek-logo.png"
        alt="Maakleerplek"
        class="w-10 h-10 rounded-lg object-contain animate-pulse-gentle"
      />
      <div class="flex flex-col">
        <span class="text-xl font-semibold text-primary tracking-tight"
          >{config.branding.organizationName}</span
        >
        <span
          class="text-[0.65rem] text-text-tertiary font-light uppercase tracking-widest"
          >{config.branding.tagline}</span
        >
      </div>
    </div>
    <div class="flex items-center gap-6">
      <div
        class="text-sm font-normal text-text-secondary capitalize"
        id="live-clock"
      >
      </div>
    </div>
  </header>

  <!-- ===== Main Three-Panel Layout ===== -->
  <main class="flex h-[calc(100vh-64px)] overflow-hidden">
    <!-- Left Sidebar: Calendar -->
    <aside
      class="w-[18%] min-w-[220px] border-r border-border bg-surface p-4 overflow-hidden flex flex-col"
    >
      <CalendarPanel />
    </aside>

    <!-- Center: News Carousel -->
    <section class="flex-1 bg-background p-4 overflow-hidden flex flex-col">
      <NewsCarousel />
    </section>

    <!-- Right Sidebar: Drinks + Tips -->
    <aside
      class="w-[26%] min-w-[280px] border-l border-border bg-surface p-4 overflow-hidden flex flex-col"
    >
      <div class="flex-1 overflow-hidden">
        <DrinksPanel />
      </div>
      <div class="mt-3">
        <TipsBox />
      </div>
    </aside>
  </main>
</Layout>

<style>
  @keyframes pulse-gentle {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.04);
    }
  }
  .animate-pulse-gentle {
    animation: pulse-gentle 4s ease-in-out infinite;
  }
</style>

<script
  define:vars={{
    intervalSeconds: config.carousel.intervalSeconds,
    transitionSpeedMs: config.carousel.transitionSpeedMs,
    autoRefreshMinutes: config.carousel.autoRefreshMinutes,
    apiBase: browserBaseUrl,
    calendarEndpoint: "/calendar",
    newsEndpoint: "/news",
    drinksEndpoint: "/drinks",
    maxEvents: config.calendar.maxEventsToShow,
    maxNews: config.news.maxItems,
  }}
>
  document.addEventListener("DOMContentLoaded", () => {
    // ── Live Clock ──────────────────────────────────────────
    const clockEl = document.getElementById("live-clock");
    function updateClock() {
      if (!clockEl) return;
      const now = new Date();
      const opts = {
        weekday: "long",
        day: "numeric",
        month: "long",
        hour: "2-digit",
        minute: "2-digit",
      };
      clockEl.textContent = now.toLocaleDateString("nl-BE", opts);
    }
    updateClock();
    setInterval(updateClock, 1000);

    // ── Auto Refresh ────────────────────────────────────────
    if (autoRefreshMinutes > 0) {
      setInterval(
        () => {
          window.location.reload();
        },
        autoRefreshMinutes * 60 * 1000,
      );
    }

    // ── Utility functions ───────────────────────────────────
    const LOCATION_COLORS = {
      "high tech lab": "#0077B6",
      textiellab: "#E76F51",
      "grafisch lab": "#9B5DE5",
      gereedschappenbib: "#F4A261",
      "elektro herstel hub": "#2A9D8F",
      kantine: "#E63946",
      "cowork plek": "#457B9D",
      "deelplek ateliers": "#6D6875",
      "textiel herstel hub": "#E5989B",
    };

    function getLocationColor(location) {
      if (!location) return "#008080";
      const lower = location.toLowerCase();
      for (const [key, color] of Object.entries(LOCATION_COLORS)) {
        if (lower.includes(key)) return color;
      }
      return "#008080";
    }

    function formatDateHeader(dateText) {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);
      const cleaned = dateText.trim().toLowerCase();
      const dayMatch = cleaned.match(/\w+\s+(\d+)\s+(\w+)/);
      if (dayMatch) {
        const day = parseInt(dayMatch[1], 10);
        if (day === today.getDate()) return "Today";
        if (day === tomorrow.getDate()) return "Tomorrow";
      }
      return dateText.charAt(0).toUpperCase() + dateText.slice(1);
    }

    function truncate(text, max) {
      if (!text) return "";
      return text.length > max ? text.substring(0, max) + "\u2026" : text;
    }

    function esc(text) {
      if (!text) return "";
      const el = document.createElement("span");
      el.textContent = text;
      return el.innerHTML;
    }

    function stripHtml(html) {
      if (!html) return "";
      const tmp = document.createElement("DIV");
      tmp.innerHTML = html;
      return tmp.textContent || tmp.innerText || "";
    }

    // ══════════════════════════════════════════════════════════
    //  Render Calendar Panel
    // ══════════════════════════════════════════════════════════
    function renderCalendar(events) {
      const container = document.getElementById("calendar-events");
      if (!container) return;
      container.innerHTML = "";

      if (!events || events.length === 0) {
        container.innerHTML =
          '<div class="flex flex-col items-center justify-center h-full text-text-tertiary gap-2">' +
          '<span class="material-symbols-outlined text-4xl">event_busy</span>' +
          '<p class="text-sm">No upcoming events</p>' +
          "</div>";
        return;
      }

      const display = events.slice(0, maxEvents);
      let html = "";

      for (const ev of display) {
        const color = getLocationColor(ev.location);
        const dateLabel = ev.date ? formatDateHeader(ev.date) : "";

        html +=
          '<div class="bg-surface rounded-md px-2 py-1.5 border border-border/80 shadow-sm transition-all mb-1.5">' +
          '<div class="flex items-center justify-between gap-1 mb-0.5 flex-wrap">';

        if (dateLabel) {
          html +=
            '<span class="text-[0.55rem] font-bold text-primary uppercase tracking-tighter">' +
            esc(dateLabel) +
            "</span>";
        }
        if (ev.time) {
          html +=
            '<span class="text-[0.55rem] text-text-tertiary font-bold">' +
            esc(ev.time) +
            "</span>";
        }

        html +=
          "</div>" +
          '<h4 class="text-[0.75rem] font-medium text-text-primary leading-tight mb-1 truncate">' +
          esc(ev.title) +
          "</h4>";

        if (ev.location) {
          html +=
            '<span class="inline-flex items-center gap-0.5 text-[0.5rem] font-medium px-1 rounded-sm py-0 bg-surface-variant text-text-tertiary">' +
            '<span class="material-symbols-outlined text-[0.6rem]">location_on</span>' +
            esc(ev.location) +
            "</span>";
        }

        html += "</div>";
      }

      container.innerHTML = html;
    }

    // ══════════════════════════════════════════════════════════
    //  Render News Carousel
    // ══════════════════════════════════════════════════════════
    let currentSlide = 0;
    let newsItems = [];
    let carouselInterval = null;

    function createSlideHtml(item) {
      const imageHtml = item.imageUrl
        ? '<img src="' +
          esc(item.imageUrl) +
          '" alt="' +
          esc(item.title) +
          '" class="w-full h-full object-cover" loading="lazy" />'
        : '<div class="w-full h-full flex items-center justify-center bg-surface-variant">' +
          '<span class="material-symbols-outlined text-border text-6xl">newspaper</span>' +
          "</div>";

      return (
        '<div class="bg-surface rounded-2xl shadow-card w-full h-full flex flex-row p-8 gap-10 overflow-hidden">' +
        // Left Column: Image + Date
        '<div class="w-[45%] flex flex-col gap-4 flex-shrink-0">' +
        '<div class="flex-1 rounded-2xl overflow-hidden bg-surface-variant relative shadow-sm">' +
        imageHtml +
        "</div>" +
        (item.date
          ? '<div class="text-base font-medium text-text-secondary flex items-center gap-2 pl-2">' +
            '<span class="material-symbols-outlined text-xl">calendar_today</span>' +
            esc(item.date) +
            "</div>"
          : "") +
        "</div>" +
        // Right Column: Title + Description
        '<div class="flex-1 flex flex-col justify-center overflow-hidden py-4">' +
        '<h3 class="text-3xl font-bold text-text-primary leading-tight mb-6">' +
        esc(truncate(item.title, 100)) +
        "</h3>" +
        (item.description
          ? '<p class="text-lg text-text-secondary leading-relaxed line-clamp-6">' +
            esc(truncate(stripHtml(item.description), 500)) +
            "</p>"
          : "") +
        "</div>" +
        "</div>"
      );
    }

    function renderNewsCarousel(items) {
      const viewport = document.getElementById("carousel-viewport");
      if (!viewport) return;

      newsItems = (items || []).slice(0, maxNews);

      if (newsItems.length === 0) {
        viewport.innerHTML =
          '<div class="flex flex-col items-center justify-center h-full text-text-tertiary gap-2">' +
          '<span class="material-symbols-outlined text-5xl">article</span>' +
          '<p class="text-base">No recent news found</p>' +
          "</div>";
        return;
      }

      // Create slides
      let slidesHtml = "";
      for (let i = 0; i < newsItems.length; i++) {
        slidesHtml +=
          '<div class="carousel-slide" data-state="hidden" data-index="' +
          i +
          '">' +
          createSlideHtml(newsItems[i]) +
          "</div>";
      }
      viewport.innerHTML =
        '<div class="carousel-3d-stage" id="carousel-track">' +
        slidesHtml +
        "</div>";

      // Set initial states
      currentSlide = 0;
      updateSlideStates();
      startCarousel();
    }

    function updateSlideStates() {
      const slides = document.querySelectorAll(".carousel-slide");
      const total = newsItems.length;

      slides.forEach((slide) => {
        const idx = parseInt(slide.getAttribute("data-index"));

        if (idx === currentSlide) {
          // The slide that is currently showing
          slide.setAttribute("data-state", "active");
        } else if (idx === (currentSlide - 1 + total) % total) {
          // The slide that just finished showing (moves left)
          slide.setAttribute("data-state", "prev");
        } else if (idx === (currentSlide + 1) % total) {
          // The slide that will show next (staged on the right)
          slide.setAttribute("data-state", "next");
        } else {
          // All other slides hidden
          slide.setAttribute("data-state", "hidden");
        }
      });

      resetProgressBar();
    }

    function advanceSlide() {
      currentSlide = (currentSlide + 1) % newsItems.length;
      updateSlideStates();
    }

    // --- Manual Transition Polling ---
    let lastTransitionTime = 0;
    async function checkManualTransition() {
      try {
        const res = await fetch(apiBase + "/api/transition/check");
        if (res.ok) {
          const data = await res.json();
          if (lastTransitionTime === 0) {
            lastTransitionTime = data.forceTransitionTime;
          } else if (data.forceTransitionTime > lastTransitionTime) {
            lastTransitionTime = data.forceTransitionTime;
            advanceSlide();
          }
        }
      } catch (e) {
        // silently ignore fetch errors for the manual trigger
      }
    }

    // Check every 2 seconds for a manual transition trigger
    setInterval(checkManualTransition, 2000);

    let progressAnimFrame;
    let slideStartTime;

    function resetProgressBar() {
      const bar = document.getElementById("news-progress-bar");
      if (!bar) return;

      if (progressAnimFrame) cancelAnimationFrame(progressAnimFrame);

      slideStartTime = Date.now();
      const durationMs = intervalSeconds * 1000;

      function updateProgress() {
        const elapsed = Date.now() - slideStartTime;
        let p = Math.min((elapsed / durationMs) * 100, 100);
        bar.style.width = p + "%";

        if (elapsed < durationMs) {
          progressAnimFrame = requestAnimationFrame(updateProgress);
        }
      }

      progressAnimFrame = requestAnimationFrame(updateProgress);
    }

    function startCarousel() {
      if (carouselInterval) clearInterval(carouselInterval);
      if (newsItems.length > 1) {
        resetProgressBar();
        carouselInterval = setInterval(advanceSlide, intervalSeconds * 1000);
      }
    }

    // ══════════════════════════════════════════════════════════
    //  Render Drinks Panel
    // ══════════════════════════════════════════════════════════
    function renderDrinks(drinks) {
      const container = document.getElementById("drinks-list");
      if (!container) return;
      container.innerHTML = "";

      if (!drinks || drinks.length === 0) {
        container.innerHTML =
          '<li class="flex flex-col items-center justify-center h-full text-text-tertiary gap-2 py-4">' +
          '<span class="material-symbols-outlined text-4xl">local_bar</span>' +
          '<p class="text-sm">Menu unavailable</p>' +
          "</li>";
        return;
      }

      let html = "";
      for (const item of drinks) {
        // Fallback for missing/broken images: A generic icon.
        // Also added an onerror handler to fallback gracefully if image fails to load.
        const imageHtml = item.imageUrl
          ? '<img src="' +
            esc(item.imageUrl) +
            '" onerror="this.outerHTML=\'<div class=\\\'w-8 h-8 flex-shrink-0 rounded-md bg-surface-variant border border-border/50 flex flex-col items-center justify-center\\\'><span class=\\\'material-symbols-outlined text-sm text-text-tertiary\\\'>local_bar</span></div>\'" class="w-8 h-8 flex-shrink-0 rounded-md object-cover border border-border/50 bg-white" alt="drink" />'
          : '<div class="w-8 h-8 flex-shrink-0 rounded-md bg-surface-variant border border-border/50 flex flex-col items-center justify-center"><span class="material-symbols-outlined text-sm text-text-tertiary">local_bar</span></div>';

        const stockHtml =
          item.stock > 0
            ? '<span class="text-[0.6rem] px-1 py-0.5 rounded-sm text-white bg-primary whitespace-nowrap">' +
              parseInt(item.stock) +
              " in stock</span>"
            : '<span class="text-[0.6rem] px-1 py-0.5 rounded-sm text-white bg-error whitespace-nowrap">Out of stock</span>';

        html +=
          '<li class="flex items-start gap-3 py-2 border-b border-border/40 break-inside-avoid w-full">' +
          imageHtml +
          '<div class="flex-1 min-w-0 flex flex-col">' +
          '<div class="flex items-baseline justify-between gap-1 w-full">' +
          '<span class="text-sm font-semibold text-text-primary truncate">' +
          esc(item.name) +
          "</span>" +
          '<span class="text-sm font-bold text-primary whitespace-nowrap">' +
          esc(item.price) +
          "</span>" +
          "</div>" +
          '<div class="mt-1 flex items-center">' +
          stockHtml +
          "</div>" +
          "</div>" +
          "</li>";
      }

      container.innerHTML = html;
    }

    // ══════════════════════════════════════════════════════════
    //  Fetch Data (Parallel execution for faster load)
    // ══════════════════════════════════════════════════════════
    async function fetchData() {
      const drinksEndpoint = "/api/drinks";

      Promise.allSettled([
        fetch(apiBase + calendarEndpoint).then(async (res) => {
          if (res.ok) renderCalendar(await res.json());
          else throw new Error("Calendar fetch failed");
        }),
        fetch(apiBase + newsEndpoint).then(async (res) => {
          if (res.ok) renderNewsCarousel(await res.json());
          else throw new Error("News fetch failed");
        }),
        fetch(apiBase + drinksEndpoint).then(async (res) => {
          if (res.ok) renderDrinks(await res.json());
          else throw new Error("Drinks fetch failed");
        }),
      ]).then((results) => {
        results.forEach((r, idx) => {
          if (r.status === "rejected") {
            console.warn(`[TV] Fetch ${idx} failed:`, r.reason);
          }
        });
      });
    }

    fetchData();
  });
</script>
