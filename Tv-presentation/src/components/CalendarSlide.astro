---
export interface Props {
  events: Array<{
    title: string;
    location: string;
    date: string;
    dateISO?: string;
    time?: string;
    description?: string;
    imageUrl?: string;
    link?: string;
  }>;
  title?: string;
  maxEvents?: number;
}

const { events = [], title = "Kalender", maxEvents = 8 } = Astro.props;

// Group events by date
const groupedEvents: Record<string, typeof events> = {};
for (const event of events.slice(0, maxEvents)) {
  const key = event.date || "Onbekend";
  if (!groupedEvents[key]) groupedEvents[key] = [];
  groupedEvents[key].push(event);
}

// Location → color mapping
const locationColors: Record<string, string> = {
  "High Tech Lab": "#0077B6",
  "TextielLab": "#E76F51",
  "Grafisch Lab": "#9B5DE5",
  "GEREEDSCHAPPENBIB": "#F4A261",
  "Elektro Herstel Hub": "#2A9D8F",
  "Kantine": "#E63946",
  "Cowork plek": "#457B9D",
  "Deelplek Ateliers": "#6D6875",
  "Textiel Herstel Hub": "#E5989B",
};

function getLocationColor(location: string): string {
  for (const [key, color] of Object.entries(locationColors)) {
    if (location.toLowerCase().includes(key.toLowerCase())) return color;
  }
  return "var(--primary)";
}

// Format the date header
function formatDateHeader(dateText: string): string {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const tomorrow = new Date(today);
  tomorrow.setDate(tomorrow.getDate() + 1);

  // Try to match the dateText against today/tomorrow
  const cleaned = dateText.trim().toLowerCase();
  const dayMatch = cleaned.match(/\w+\s+(\d+)\s+(\w+)/);
  if (dayMatch) {
    const day = parseInt(dayMatch[1], 10);
    const todayDay = today.getDate();
    const tomorrowDay = tomorrow.getDate();
    if (day === todayDay) return "Vandaag";
    if (day === tomorrowDay) return "Morgen";
  }
  // Capitalize first letter
  return dateText.charAt(0).toUpperCase() + dateText.slice(1);
}
---

<div class="calendar-slide">
  <div class="slide-header">
    <span class="material-symbols-outlined slide-icon">calendar_month</span>
    <h2>{title}</h2>
  </div>

  <div class="timeline">
    {Object.entries(groupedEvents).map(([date, dayEvents]) => (
      <div class="day-group">
        <div class="day-header">
          <div class="day-dot"></div>
          <h3>{formatDateHeader(date)}</h3>
        </div>
        <div class="day-events">
          {dayEvents.map((event) => (
            <div class="event-card elevation-1">
              {event.imageUrl && (
                <div class="event-image-wrap">
                  <img src={event.imageUrl} alt={event.title} class="event-image" loading="lazy" />
                </div>
              )}
              <div class="event-content">
                <div class="event-top-row">
                  {event.location && (
                    <span
                      class="location-badge"
                      style={`background: ${getLocationColor(event.location)}15; color: ${getLocationColor(event.location)};`}
                    >
                      <span class="material-symbols-outlined badge-icon">location_on</span>
                      {event.location}
                    </span>
                  )}
                  {event.time && (
                    <span class="event-time">
                      <span class="material-symbols-outlined badge-icon">schedule</span>
                      {event.time}
                    </span>
                  )}
                </div>
                <h4 class="event-title">{event.title}</h4>
                {event.description && (
                  <p class="event-description">
                    {event.description.length > 120
                      ? event.description.substring(0, 120) + "…"
                      : event.description}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  {events.length === 0 && (
    <div class="empty-state">
      <span class="material-symbols-outlined empty-icon">event_busy</span>
      <p>Geen komende evenementen gevonden</p>
    </div>
  )}
</div>

<style>
  .calendar-slide {
    flex: 1;
    padding: 0 48px 24px;
    overflow: hidden;
  }

  .slide-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .slide-icon {
    font-size: 32px;
    color: var(--primary);
  }

  .slide-header h2 {
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .timeline {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .day-group {
    min-width: 320px;
    flex-shrink: 0;
  }

  .day-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .day-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--primary);
    flex-shrink: 0;
  }

  .day-header h3 {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--primary);
    text-transform: capitalize;
  }

  .day-events {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 16px;
    border-left: 2px solid var(--primary);
    margin-left: 5px;
  }

  .event-card {
    background: var(--surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    border: 1px solid var(--border-light);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .event-image-wrap {
    width: 100px;
    min-height: 80px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .event-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-content {
    padding: 12px 16px;
    flex: 1;
    min-width: 0;
  }

  .event-top-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .badge-icon {
    font-size: 14px !important;
  }

  .event-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .event-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: 4px;
  }

  .event-description {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 300px;
    color: var(--text-tertiary);
    gap: 12px;
  }

  .empty-icon {
    font-size: 48px;
  }
</style>
