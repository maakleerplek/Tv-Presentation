---
import config from "../data/tv-config.json";

export interface Props {
  title?: string;
}

const { title = config.news.title } = Astro.props;
---

<div class="flex flex-col h-full" id="news-carousel-container">
  <!-- Section Header -->
  <div class="flex items-center gap-2 mb-3 px-1 flex-shrink-0">
    <span class="material-symbols-outlined text-primary text-3xl"
      >newspaper</span
    >
    <h2 class="text-xl font-semibold text-text-primary">{title}</h2>
  </div>

  <!-- Carousel Area -->
  <div class="flex-1 relative overflow-hidden" id="carousel-viewport">
    <div class="carousel-track" id="carousel-track">
      <!-- Skeleton while loading -->
      <div class="w-full h-full flex items-center justify-center">
        <div
          class="bg-surface rounded-2xl shadow-card w-full h-full flex flex-row overflow-hidden animate-pulse"
        >
          <div class="w-[40%] bg-surface-variant h-full flex-shrink-0"></div>
          <div class="flex-1 p-6 flex flex-col gap-3 justify-center">
            <div class="h-3 bg-border rounded w-24"></div>
            <div class="h-6 bg-border rounded w-full"></div>
            <div class="h-4 bg-border rounded w-3/4"></div>
            <div class="h-4 bg-border rounded w-1/2"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Progress bar -->
  <div
    class="mt-3 h-1.5 w-full bg-surface-variant rounded-full overflow-hidden flex-shrink-0"
  >
    <div id="news-progress-bar" class="h-full bg-primary w-0 transition-none">
    </div>
  </div>
</div>

<style>
  .carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform, opacity;
  }

  /* Active slide — center */
  .carousel-slide[data-state="active"] {
    transform: translateX(0);
    opacity: 1;
    z-index: 10;
  }

  /* Target slide when sliding from the right */
  .carousel-slide[data-state="next"] {
    transform: translateX(100%);
    opacity: 0;
    z-index: 5;
    pointer-events: none;
  }

  /* Previous slide moving to the left */
  .carousel-slide[data-state="prev"] {
    transform: translateX(-100%);
    opacity: 0;
    z-index: 5;
    pointer-events: none;
  }

  /* Hidden slides */
  .carousel-slide[data-state="hidden"] {
    transform: translateX(100%);
    opacity: 0;
    z-index: 1;
    pointer-events: none;
  }
</style>
