---
import config from "../data/tv-config.json";

export interface Props {
  title?: string;
}

const t = config.tips;
const { title = t.title } = Astro.props;
---

<div
  class="bg-primary-container rounded-xl p-3 border border-primary/15"
  id="tips-box"
>
  <div class="flex items-start gap-2">
    <span
      class="material-symbols-outlined text-primary text-xl flex-shrink-0 mt-0.5"
      >lightbulb</span
    >
    <div>
      <h3
        class="text-xs font-semibold text-primary uppercase tracking-wider mb-1"
      >
        {title}
      </h3>
      <p
        class="text-sm text-text-secondary leading-relaxed transition-opacity duration-500"
        id="tip-text"
      >
        {t.items[0]}
      </p>
    </div>
  </div>
</div>

<script
  define:vars={{
    tips: t.items,
    intervalSeconds: t.intervalSeconds,
  }}
>
  document.addEventListener("DOMContentLoaded", () => {
    const tipEl = document.getElementById("tip-text");
    if (!tipEl || tips.length <= 1) return;

    let currentIndex = 0;

    setInterval(() => {
      // Fade out
      tipEl.style.opacity = "0";

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % tips.length;
        tipEl.textContent = tips[currentIndex];
        // Fade in
        tipEl.style.opacity = "1";
      }, 400);
    }, intervalSeconds * 1000);
  });
</script>
