---
export interface Props {
  newsItems: Array<{
    title: string;
    description?: string;
    imageUrl?: string;
    date?: string;
    link?: string;
  }>;
  title?: string;
  maxItems?: number;
}

const { newsItems = [], title = "Nieuws", maxItems = 4 } = Astro.props;
const displayItems = newsItems.slice(0, maxItems);
---

<div class="news-slide">
  <div class="slide-header">
    <span class="material-symbols-outlined slide-icon">newspaper</span>
    <h2>{title}</h2>
  </div>

  <div class="news-grid">
    {displayItems.map((item, index) => (
      <article class={`news-card elevation-2 ${index === 0 ? "featured" : ""}`}>
        {item.imageUrl && (
          <div class="news-image-wrap">
            <img
              src={item.imageUrl}
              alt={item.title}
              class="news-image"
              loading="lazy"
            />
            <div class="image-gradient"></div>
          </div>
        )}
        <div class="news-content">
          {item.date && (
            <span class="news-date">
              <span class="material-symbols-outlined date-icon">calendar_today</span>
              {item.date}
            </span>
          )}
          <h3 class="news-title">{item.title}</h3>
          {item.description && (
            <p class="news-description">
              {item.description.length > 150
                ? item.description.substring(0, 150) + "…"
                : item.description}
            </p>
          )}
        </div>
      </article>
    ))}
  </div>

  {displayItems.length === 0 && (
    <div class="empty-state">
      <span class="material-symbols-outlined empty-icon">article</span>
      <p>Geen recent nieuws gevonden</p>
    </div>
  )}
</div>

<style>
  .news-slide {
    flex: 1;
    padding: 0 48px 24px;
    overflow: hidden;
  }

  .slide-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .slide-icon {
    font-size: 32px;
    color: var(--primary);
  }

  .slide-header h2 {
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    height: calc(100vh - 200px);
  }

  .news-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-light);
    transition: transform 0.2s ease;
  }

  .news-card.featured {
    grid-column: 1 / -1;
    flex-direction: row;
    max-height: 260px;
  }

  .news-card.featured .news-image-wrap {
    width: 45%;
    height: 100%;
    min-height: 260px;
  }

  .news-image-wrap {
    position: relative;
    width: 100%;
    height: 180px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .news-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.15));
  }

  .news-content {
    padding: 20px 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .news-date {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .date-icon {
    font-size: 14px !important;
  }

  .news-title {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: 8px;
  }

  .news-card.featured .news-title {
    font-size: 1.4rem;
  }

  .news-description {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 300px;
    color: var(--text-tertiary);
    gap: 12px;
  }

  .empty-icon {
    font-size: 48px;
  }
</style>
