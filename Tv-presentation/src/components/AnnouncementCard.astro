---
export interface Props {
  title: string;
  content: string;
  category?: string;
  date?: string;
  icon?: string;
  imageUrl?: string;
  location?: string;
}

const {
  title,
  content,
  category = "General",
  date,
  icon = "campaign",
  imageUrl,
  location,
} = Astro.props;

const categoryColors: Record<string, string> = {
  General: "#6750a4",
  Urgent: "#b3261e",
  Event: "#006c4c",
  Info: "#0061a4",
};

const color = categoryColors[category] ?? categoryColors["General"];
---

<article class="card elevation-2">
  <div class="card-image-container">
    {imageUrl && <img src={imageUrl} alt={title} class="card-image" />}
  </div>
  <div class="card-body">
    <div class="card-header">
      <div class="card-icon" style={`background: ${color};`}>
        <span class="material-symbols-outlined">{icon}</span>
      </div>
      <div class="card-meta">
        <span class="card-category" style={`color: ${color};`}>{category}</span>
        {date && <span class="card-date">{date}</span>}
        {location && <span class="card-location">{location}</span>}
      </div>
    </div>
    <h2 class="card-title">{title}</h2>
    <p class="card-content">{content}</p>
  </div>
</article>

<style>
  .card {
    background: #ffffff;
    border-radius: 16px;
    transition:
      box-shadow 0.25s ease,
      transform 0.25s ease;
    border: 1px solid rgba(0, 0, 0, 0.04);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .card-image-container {
    width: 100%;
    height: 180px;
    background: #f5f5f5;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: 24px;
  }

  .card:hover {
    box-shadow:
      0 10px 20px rgba(0, 0, 0, 0.08),
      0 3px 6px rgba(0, 0, 0, 0.05);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: white;
    flex-shrink: 0;
  }

  .card-icon .material-symbols-outlined {
    font-size: 22px;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
  }

  .card-category {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card-date,
  .card-location {
    font-size: 0.75rem;
    color: #79747e;
  }

  .card-location {
    font-style: italic;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 8px;
    color: #1c1b1f;
  }

  .card-content {
    font-size: 0.95rem;
    line-height: 1.55;
    color: #49454f;
  }
</style>
