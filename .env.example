# ===== TV Presentation Config =====

# ── Ports ────────────────────────────────────────────────────────
# Host port for the frontend (http://localhost:HOST_PORT)
HOST_PORT=8083

# ── Data fetcher ─────────────────────────────────────────────────
# URL Next.js uses to reach the data-fetcher inside Docker
DATA_FETCHER_INTERNAL_URL=http://data-fetcher:8080
# URL Next.js falls back to when running outside Docker (local dev)
DATA_FETCHER_EXTERNAL_URL=http://localhost:8085

# ── Scraper targets ───────────────────────────────────────────────
# Base URL of the maakleerplek website (no trailing slash)
MAAKLEERPLEK_URL=https://maakleerplek.be

# ── Cache / refresh ───────────────────────────────────────────────
# How long scraped data is cached on the data-fetcher (minutes)
CACHE_DURATION_MINUTES=15
# How often the browser re-fetches screen data (minutes)
NEXT_PUBLIC_SCREEN_DATA_POLL_MINUTES=5

# ── Content limits ────────────────────────────────────────────────
# Max age of news articles shown on screen (days)
NEWS_MAX_AGE_DAYS=14
# Max number of news articles to fetch
MAX_NEWS_ITEMS=6
# Max number of calendar events that get detail-page enrichment
MAX_EVENT_DETAILS=30

# ── Carousel ──────────────────────────────────────────────────────
# Seconds each carousel slide is shown before advancing
CAROUSEL_TRANSITION_TIME=15
# Seconds each page of the drinks list is shown before advancing
DRINKS_TRANSITION_TIME=30
# Seconds each tip is shown before advancing
TIPS_TRANSITION_TIME=10

# ── Event priority ────────────────────────────────────────────────
# Comma-separated keywords in priority order (highest first).
# The "Nu bezig" / "Volgend evenement" panel picks the event whose title
# contains the earliest keyword. Events with no matching keyword are shown last.
# Example: openlab always beats a workshop; repair beats a generic event.
EVENT_PRIORITY=open (high tech) lab,repair,young maker

# ── Drinks refresh ────────────────────────────────────────────────
# How often the drinks/inventory data is re-fetched from InvenTree (minutes)
DRINKS_CACHE_DURATION_MINUTES=5

# ── Inventree integration ─────────────────────────────────────────
INVENTREE_URL=your-inventree-url
INVENTREE_TOKEN=your-inventree-token
INVENTREE_DRINKS_CATEGORY=drinks
# Comma-separated list of InvenTree location names to show in the drinks panel
# e.g. INVENTREE_DRINKS_LOCATIONS=HTL-fridge,HTL-snacks
INVENTREE_DRINKS_LOCATIONS=HTL-fridge

# ── Weather ───────────────────────────────────────────────────────
# Coordinates used for the Open-Meteo weather fetch (no API key needed)
WEATHER_LAT=50.8798
WEATHER_LON=4.7005

# ── Tips footer ───────────────────────────────────────────────────
# One tip per TIP_n variable, numbered from 1 upward.
# Remove or leave a line blank to stop the list there.
TIP_1=Ruim je werkplek op na gebruik. Een nette ruimte is een veilige ruimte!
TIP_2=Hulp nodig met een machine? Vraag een vrijwilliger met een blauwe lanyard.
TIP_3=Veiligheid eerst: draag altijd een veiligheidsbril bij het gebruik van gereedschap.

# ── Drinks panel ──────────────────────────────────────────────────
# URL encoded into the payment QR code shown in the drinks panel
PAYMENT_QR_URL=https://your-payment-url.example.com
