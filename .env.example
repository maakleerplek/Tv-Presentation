# ===== TV Presentation Config =====

# Host IP address to bind the service to (use 0.0.0.0 to listen on all interfaces)
HOST_IP=0.0.0.0

# Port to expose the TV presentation on (HTTP)
HOST_PORT=8083

# Port for HTTPS
HTTPS_PORT=8084

# Java Backend API URL (used later for the data fetcher)
API_BASE_URL=http://localhost:8080
API_IP=localhost

# Inventree Integration
INVENTREE_URL=your-inventree-url
INVENTREE_TOKEN=your-inventree-token
INVENTREE_DRINKS_CATEGORY=drinks
INVENTREE_DRINKS_LOCATION=HTL-fridge
